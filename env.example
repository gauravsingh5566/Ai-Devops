# ============================================================================
# AI DevOps Assistant - Complete System Environment Configuration
# ============================================================================
# This file contains ALL environment variables needed for the complete system
# Copy this file to .env and fill in your actual values
# ============================================================================

# ============================================================================
# REQUIRED: Claude AI API Key
# ============================================================================
# Get your API key from: https://console.anthropic.com/
# This is used by:
#   - AI Service (for code generation and intent parsing)
#   - RAG Service (for embedding generation)
#ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ============================================================================
# REQUIRED: AWS Credentials (for Infrastructure Deployment)
# ============================================================================
# These are needed ONLY if you plan to deploy infrastructure to AWS
# Get these from AWS IAM Console: https://console.aws.amazon.com/iam/
# The user/role should have permissions to create VPC, EC2, RDS, etc.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=


# AWS Region (default: us-east-1)
# Options: us-east-1, us-west-2, eu-west-1, ap-southeast-1, etc.
AWS_REGION=us-east-1

# ============================================================================
# OPTIONAL: Service Configuration (Already set in docker-compose)
# ============================================================================
# These are already configured in docker-compose-complete.yml with defaults
# Uncomment and modify only if you need to override default

# Claude Model (default: claude-sonnet-4-20250514)
# CLAUDE_MODEL=claude-sonnet-4-20250514

# Qdrant Configuration (default: qdrant:6333)
# QDRANT_HOST=qdrant
# QDRANT_PORT=6333

# Service URLs (default: using Docker service names)
# These are used for inter-service communication within Docker network
# AI_SERVICE_URL=http://ai-service:8001
# RAG_SERVICE_URL=http://rag-service:8002
# MCP_SERVICE_URL=http://mcp-service:8003
# INFRA_SERVICE_URL=http://infra-service:8004

# ============================================================================
# OPTIONAL: Advanced Configuration
# ============================================================================

# Log Level (default: INFO)
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO

# Terraform Backend Configuration (for remote state)
# Uncomment if you want to use S3 backend for Terraform state
# TERRAFORM_BACKEND_TYPE=s3
# TERRAFORM_BACKEND_BUCKET=my-terraform-state-bucket
# TERRAFORM_BACKEND_KEY=ai-devops/terraform.tfstate
# TERRAFORM_BACKEND_REGION=us-east-1
# TERRAFORM_BACKEND_DYNAMODB_TABLE=terraform-state-lock

# RAG Configuration
# Default collection name
# RAG_COLLECTION=aws_best_practices

# Max number of search results
# RAG_MAX_RESULTS=10

# MCP Service Configuration
# Validation timeout in seconds
# MCP_VALIDATION_TIMEOUT=30

# Cost calculation mode (simplified or detailed)
# MCP_COST_MODE=simplified

# ============================================================================
# NOTES
# ============================================================================
# 1. NEVER commit this file with real credentials to version control
# 2. Add .env to your .gitignore file
# 3. For production, use secrets management (AWS Secrets Manager, etc.)
# 4. AWS credentials are only needed if you plan to deploy to AWS
# 5. All services will work without AWS credentials except deployment
# ============================================================================

# ============================================================================
# QUICK START CHECKLIST
# ============================================================================
# [ ] Set ANTHROPIC_API_KEY (required for AI features)
# [ ] Set AWS credentials (required only for deployments)
# [ ] Set AWS_REGION to your preferred region
# [ ] Save this file as .env in the same directory as docker-compose-complete.yml
# [ ] Run: docker-compose -f docker-compose-complete.yml up -d
# [ ] Wait 30 seconds for services to start
# [ ] Seed RAG: curl -X POST http://localhost:8002/seed
# [ ] Open browser: http://localhost:8501
# ============================================================================